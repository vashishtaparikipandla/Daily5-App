{
  "expo": {
    "name": "Daily 5",
    "slug": "daily5-android",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "daily5-android",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F4EF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.daily5.android"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#F7F4EF"
      },
      "package": "app.daily5.android"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Daily 5 needs access to your photos to attach them to diary entries.",
          "cameraPermission": "Daily 5 needs access to your camera to take photos for diary entries."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Daily 5 uses Face ID so you can unlock your diary quickly."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
